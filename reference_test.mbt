    ),
    (
      "invalid-option-61",
      "",
      1,
      [],
    ),
  ]
  for (name, hex, expected, logical) in cases {
    let actual = try {
      let packet = @moondhcp4.decode(@moondhcp4.from_hex(hex))
      for (code, value) in logical {
        assert_eq(packet.option(code), Some(@moondhcp4.from_hex(value)))
      }
      if packet.diagnose().any(i => i.severity == "error") {
        1
      } else {
        0
      }
    } catch {
      @moondhcp4.Malformed(_, _) | @moondhcp4.InvalidModel(_) => 2
      @moondhcp4.Limit(_) => 4
      error => fail("\{name}: unexpected test error \{error}")
    }
    if actual != expected {
      fail("\{name}: expected \{expected}, got \{actual}")
    }
  }
}
